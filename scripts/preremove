#!/usr/bin/env bash
root_dir="/etc/lantern-headless"
service_name="lantern-headless"
service_unit="lantern-headless.service"
sysvinit_script="lantern-headless.sysvinit"
sysvinit_dir="/etc/init.d/"

error(){
    echo -e "\e[91m$(date "+%Y-%m-%d %H:%M:%S.%3N")\t[ERRO]\t$1\e[0m"
}
warn(){
    echo -e "\e[93m$(date "+%Y-%m-%d %H:%M:%S.%3N")\t[WARN]\t$1\e[0m"
}
info(){
    echo -e "\e[96m$(date "+%Y-%m-%d %H:%M:%S.%3N")\t[INFO]\t$1\e[0m"
}
succ(){
    echo -e "\e[92m$(date "+%Y-%m-%d %H:%M:%S.%3N")\t[SUCC]\t$1\e[0m"
}

expect(){
    $1
    rtc=$?
    if [ $rtc -ne 0 ]; then
        if [ -n "$2" ]; then
            $2
        fi
	    error "when exec $1, an unexpected error occurred, code: $rtc"
	    exit $rtc
	fi
}

unbounded_unit="lantern-unbounded.service"

# deb passes "upgrade"/"deconfigure"/"failed-upgrade" on upgrades and "remove"
# on removal; rpm passes the number of versions that will remain (0 on
# removal); apk and Arch pass nothing and only run this on removal.
is_upgrade() {
    case "${1:-}" in
        upgrade|deconfigure|failed-upgrade) return 0 ;;
        [1-9]*) return 0 ;;
    esac
    return 1
}

disable_service() {
  	info "disable service"
  	if command -v systemctl >/dev/null;then
  	    expect "systemctl disable ${service_unit}"
    elif command -v update-rc.d >/dev/null || command -v chkconfig >/dev/null;then
        expect "update-rc.d -f ${service_name} remove"
        expect "chkconfig --del ${service_name}"
    else
        error "systemd/sysvinit not detected"
        exit 1
    fi
    succ "service disabled successfully"
}

# The volunteer unit is opt-in; stop it if it is running so the host does
# not keep relaying after the binary is gone.
disable_unbounded_service() {
    if command -v systemctl >/dev/null; then
        systemctl stop "${unbounded_unit}" 2>/dev/null || true
        systemctl disable "${unbounded_unit}" 2>/dev/null || true
        succ "unbounded service stopped and disabled"
    fi
}

# Remove only what the package installed. An operator's unbounded.env stays,
# as package configuration does on removal; purge it by hand if unwanted.
clean_dirs() {
    rm -f "${root_dir}/${service_unit}" "${root_dir}/${sysvinit_script}" \
          "${root_dir}/${unbounded_unit}" "${root_dir}/unbounded.env.example"
    rmdir "${root_dir}" 2>/dev/null || true
    if command -v systemctl >/dev/null; then
        systemctl daemon-reload 2>/dev/null || true
    fi
}

if is_upgrade "${1:-}"; then
    info "upgrade in progress; leaving services and configuration in place"
    exit 0
fi

disable_unbounded_service
disable_service
clean_dirs
