# Configuration for lantern-unbounded.service. Copy to
# /etc/lantern-headless/unbounded.env and uncomment what you want to change.
# Every setting is also a flag of `lantern-headless unbounded`; see --help.

# How many censored users to help at once.
#UNBOUNDED_MAX_PEERS=5

# Cap the relayed byte rate in each direction: 5mbit, 500KB/s, 1.5MiB/s ...
#UNBOUNDED_BANDWIDTH_LIMIT=5mbit

# Stop helping once this much has been relayed in a period, until the period
# rolls over: 50GB/day, 200GiB/week, 1TB/month ...
#UNBOUNDED_DATA_CAP=50GB/day

# Prefer users from these countries (ISO 3166-1 alpha-2, comma-separated).
#UNBOUNDED_TARGET_COUNTRIES=IR,RU

# How often to log relay statistics; 0 disables.
#UNBOUNDED_STATS_INTERVAL=60s

# How long a WebRTC attempt may spend in NAT traversal before giving up.
#UNBOUNDED_NAT_FAIL_TIMEOUT=15s

# Discovery and egress servers. The defaults are Lantern's production swarm.
#UNBOUNDED_FREDDIE=https://freddie.iantem.io
#UNBOUNDED_EGRESS=wss://unbounded.iantem.io:443
